{
  "name": "flow",
  "version": "0.3.0-platform-mvp",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/alohasoyrico-eng/Flow3.0.git"
  },
  "exports": {
    "./tokens": "./packages/tokens/src/index.js",
    "./tokens/styles.css": "./packages/tokens/styles/tokens.css",
    "./components": "./packages/components/src/index.js",
    "./components/contracts": "./packages/components/src/contracts.js",
    "./components/platforms": "./packages/components/src/platforms/index.js",
    "./components/styles.css": "./packages/components/styles/components.css",
    "./react": "./packages/react/dist/index.js",
    "./react/button": "./packages/react/dist/Button.js",
    "./react/card-expiry-input": "./packages/react/dist/CardExpiryInput.js",
    "./react/card-number-input": "./packages/react/dist/CardNumberInput.js",
    "./react/card-security-code-input": "./packages/react/dist/CardSecurityCodeInput.js",
    "./react/code-input": "./packages/react/dist/CodeInput.js",
    "./react/date-picker": "./packages/react/dist/DatePicker.js",
    "./react/date-range-picker": "./packages/react/dist/DateRangePicker.js",
    "./react/icon-button": "./packages/react/dist/IconButton.js",
    "./react/inline-validation": "./packages/react/dist/InlineValidation.js",
    "./react/input": "./packages/react/dist/Input.js",
    "./react/phone-input": "./packages/react/dist/PhoneInput.js",
