{
  "schemaVersion": "ds-release-gate@1",
  "status": "pass",
  "decision": "Flow core is releasable by package/runtime gates; FlowDocs remains separately audited.",
  "authority": {
    "releaseGate": "npm run validate:flow-core",
    "compatibilityAlias": "npm run validate:system",
    "nonAuthoritativeForCore": [
      "npm run audit",
      "npm run audit:complete",
      "npm run audit:flowdocs-consumer-gate",
      "npm run audit:forensic-gate"
    ]
  },
  "flowdocsBoundary": {
    "forbiddenTargets": [
      "../FlowDocs",
      "FlowDocs/apps/docs",
      "apps/docs/index.html",
      "audit:flowdocs",
      "validate:docs"
    ],
    "forbiddenTargetFindings": []
  },
  "testBoundary": {
    "reactTestExcludesLegacyInteraction": true,
    "reactReleaseExcludesLegacyInteraction": true,
    "legacyInteractionQuarantineExists": true,
    "legacyInteractionCommand": "node test/interaction.test.mjs"
  },
  "checks": [
