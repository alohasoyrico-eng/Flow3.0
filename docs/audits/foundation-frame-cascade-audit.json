    },
    {
      "from": "Accessibility",
      "to": "Frame",
      "status": "active",
      "reason": "Accessible target size composes the minimum touch target with Frame control height so density cannot shrink interaction below usable geometry."
    },
    {
      "from": "Depth",
      "to": "Frame",
      "status": "active",
      "reason": "Depth lift distances use Frame geometry so motion/depth offsets scale with the frame system."
    },
    {
      "from": "Frame",
      "to": "Density",
      "status": "context",
      "reason": "Frame runtime geometry delegates control size, padding, and gaps to the viewport/density context."
    },
