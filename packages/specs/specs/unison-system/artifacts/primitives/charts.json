{
  "artifacts": {
    "primitives": {
      "charts": {
        "layer": "Primitive",
        "platform": "System",
        "audiences": [
          "Product Designers",
          "Developers",
          "Content Designers",
          "Researchers",
          "Agents"
        ],
        "requiredSections": [
          "purpose",
          "foundationInputs",
          "roles",
          "productExamples",
          "api",
          "tokens",
          "states",
          "agentInstructions",
          "rejectIf"
        ],
        "maturityTarget": 3,
        "name": "Charts",
        "purpose": "Turn Energy, Accessibility, Momentum, and data roles into implementation-ready ECharts primitives for series, thresholds, legends, summaries, tooltips, empty states, and drilldown.",
        "governingFoundations": [
          "Energy",
          "Accessibility",
          "Momentum",
          "Voice",
          "State"
        ],
        "coordinatesPrimitives": [
          "Library Sources",
          "Measurement",
          "Message"
        ],
        "foundationInputs": [
          "sys.energy.*",
          "sys.accessibility.*",
          "sys.momentum.*",
          "sys.voice.*",
          "sys.state.*"
        ],
        "roles": [
          {
            "id": "series",
            "token": "chart.series.*",
            "use": "Data series color/shape/label mapping."
          },
          {
            "id": "threshold",
            "token": "chart.threshold.*",
            "use": "Risk bands and operational limits."
          },
          {
            "id": "legend",
            "token": "chart.legend.*",
            "use": "Toggleable, keyboard-reachable series control."
          },
          {
            "id": "summary",
            "token": "chart.summary",
            "use": "Text explanation of chart meaning."
          },
          {
            "id": "empty",
            "token": "chart.empty",
            "use": "No data with reason and next action."
          }
        ],
        "productExamples": [
          {
            "context": "Fuel dashboard",
            "example": "Spend trend includes threshold, accessible summary, tooltip, and table fallback."
          },
          {
            "context": "EV dashboard",
            "example": "Charging availability uses color-safe encoding and legend labels."
          },
          {
            "context": "Finance dashboard",
            "example": "Anomaly chart explains risk and drilldown path."
          }
        ],
        "api": {
          "props": [
            "type",
            "series",
            "labels",
            "segments",
            "matrix",
            "indicators",
            "thresholds",
            "target",
            "min",
            "max",
            "totals",
            "legend",
            "stack",
            "horizontal",
            "showValues",
            "palette",
            "summary",
            "emptyState",
            "drilldown"
          ],
          "types": [
            "line",
            "area",
            "bar",
            "stackedBar",
            "stacked100",
            "donut",
            "pie",
            "scatter",
            "heatmap",
            "radar",
            "waterfall",
            "pareto",
            "gauge",
            "funnel",
            "treemap",
            "boxplot"
          ],
          "outputs": [
            "echartsOption",
            "textSummary",
            "legendModel",
            "tableFallback"
          ]
        },
        "tokenDependencies": [
          "chart.*",
          "library.*",
          "sys.energy.*",
          "sys.momentum.*",
          "sys.voice.*",
          "sys.accessibility.*"
        ],
        "states": [
          "loading",
          "empty",
          "error",
          "stale",
          "interactive",
          "selected"
        ],
        "agentInstructions": [
          "Every chart needs a text summary.",
          "Use ECharts option model through primitive rules.",
          "Do not encode meaning by color alone."
        ],
        "rejectIf": [
          "Chart lacks text summary.",
          "Color is sole encoding.",
          "Empty state lacks reason/next action.",
          "Tooltip is pointer-only."
        ]
      }
    }
  }
}
