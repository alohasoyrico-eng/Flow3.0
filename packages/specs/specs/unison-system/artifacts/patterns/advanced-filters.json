          {
            "name": "toolbarBoundary",
            "owner": "pattern",
            "uses": [
              "Toolbar"
            ],
            "required": "conditional",
            "purpose": "Declares the Toolbar runtime composition boundary so this pattern composes Flow behavior instead of cloning it."
