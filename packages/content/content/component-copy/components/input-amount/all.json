{
  "components": {
    "input-amount": {
      "operational-example": {
        "copy": "Capture one monetary amount with visible currency context, native input semantics, helper or recovery copy, and the shared Flow field cascade.",
        "scenario": {
          "rationaleTitle": "Why input-amount",
          "rationale": [
            "Keeps component behavior package-owned.",
            "Preserves foundation and primitive cascade.",
            "Avoids local visual or workflow duplication."
          ]
        }
      },
      "anatomy": {
        "items": [
          {
            "part": "Field root",
            "rule": "Uses the shared field CSS contract and input-amount extension root.",
            "tokens": [
              "component-field-*",
              "comp.input-amount.*"
            ]
          },
          {
            "part": "Label",
            "rule": "Names the monetary value.",
            "tokens": [
              "sys.voice.*",
              "sys.accessibility.*"
            ]
          },
          {
            "part": "Currency context",
            "rule": "Shows currency without replacing the label.",
            "tokens": [
              "sys.symbol.*",
              "sys.voice.*"
            ]
          },
          {
            "part": "Native input",
            "rule": "Keeps decimal input semantics and paste behavior.",
            "tokens": [
              "sys.frame.*",
              "sys.state.*"
            ]
          },
          {
            "part": "Helper or error",
            "rule": "Explains limits, format, or recovery.",
            "tokens": [
              "sys.tone.*",
              "sys.voice.*"
            ]
          }
        ]
      },
      "accessibility": {
        "statePrecedence": "disabled > loading > error > filled > default",
        "items": [
          "Keep visible labels and accessible names aligned.",
          "Expose machine-readable state through props and data attributes.",
          "Do not rely on color, symbol, or placeholder text alone.",
          "Preserve keyboard, focus, disabled, loading, and recovery behavior."
        ]
      },
      "variants": {
        "copy": "input-amount variants stay semantic and do not fork visual contracts.",
        "demos": [
          {
            "label": "default",
            "variant": "default",
            "state": "default"
          }
        ]
      },
      "states": {
        "copy": "Input Amount states remain inside the shared field cascade: currency context is visible, recovery copy is textual, and Surface ownership stays outside the field.",
        "demos": [
          {
            "label": "Default",
            "state": "default",
            "value": "",
            "currency": "MXN"
          },
          {
            "label": "Filled",
            "state": "filled",
            "value": "1250.00",
            "currency": "MXN"
          },
          {
            "label": "Loading",
