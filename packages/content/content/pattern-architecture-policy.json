  "nonNegotiableMigrationRules": [
    "A pattern React implementation must compose existing Flow React components; it must not recreate Button, Dialog, Drawer, Input, Menu, Search, Table, Toast, Tooltip, or related visuals internally.",
    "Structural grouping, background, density cascade, elevation/radius coordination, and non-product surface state resolve through the Surface primitive. Card is allowed only when the formal component contract calls for a card-like content unit; Card must not become a generic group wrapper.",
    "A pattern must declare foundations and primitives explicitly before implementation. Inferred dependencies are planning evidence, not a contract.",
    "A pattern that crosses another pattern must expose a composition boundary or runtime slot according to the audit. Boundary-only dependencies must remain documented handoffs unless React actually imports and composes the dependency.",
    "A template-facing pattern may be consumed by templates, but template-specific layout, copy, and business policy stay in templates. Reusable interaction structure stays in Flow patterns.",
    "FlowDocs remains a consumer. Pattern behavior, CSS roots, props, accessibility, state contracts, and cascade rules live in Flow artifacts and React package code."
  ],
  "unusedPrimitiveClassifications": {
    "library-sources": {
      "classification": "system-governance-primitive",
      "directPatternRequired": false,
      "reason": "Library Sources governs vendor/runtime intake for other primitives; direct pattern usage would be expected only for a source-management workflow.",
      "migrationAction": "Keep as primitive governance; require consuming primitives to declare it before introducing vendors."
    },
    "maps": {
      "classificationWithTemplateMentions": "template-adjacent-primitive",
      "classificationWithoutTemplateMentions": "runtime-primitive-without-pattern",
      "directPatternRequiredWhenTemplateMentioned": true,
      "reason": "Maps has route/station template demand and must remain covered by a formal map/station-discovery pattern.",
      "migrationAction": "Restore or declare a Station Discovery-style pattern before route/station templates own map, fallback-list, or route-handoff behavior."
    },
    "illustration-assets": {
      "classificationWithTemplateMentions": "template-adjacent-asset-primitive",
      "classificationWithoutTemplateMentions": "asset-governance-primitive",
      "directPatternRequiredWhenTemplateMentioned": false,
      "reason": "Illustration Assets governs approved image sources; current formal patterns do not render illustration slots directly.",
      "migrationAction": "Keep as asset primitive; add direct pattern declaration only when an onboarding/empty/hero pattern owns illustration slots."
    }
  },
  "reason": "Pattern architecture policy keeps structural ownership explicit: Surface owns generic grouping, object components own only their formal content units, and React patterns may render only thin structural/text DOM around Flow primitives and components."
